#source ./.env
TF_VAR_api_token=root@pam!your-id=your-uuid
#TF_VAR_tailscale_auth_key='tskey-auth-...'
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# S3-compatible endpoint URL used by the Terraform S3 backend (AWS SDK standard)
AWS_ENDPOINT_URL_S3=https://your-s3-endpoint
