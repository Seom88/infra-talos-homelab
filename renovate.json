{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["dev"],
  "schedule": ["before 5am on monday"],
  "timezone": "Europe/Madrid",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Pinned talos provider alpha until #352 fixed — ADR 002",
      "matchDatasources": ["terraform-provider"],
      "matchPackageNames": ["siderolabs/talos"],
      "allowedVersions": "=0.12.0-beta.0",
      "enabled": false
    },
    {
      "description": "Talos upgrades need manual validation in libvirt/dev first",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["siderolabs/talos"],
      "labels": ["manual-review/talos"],
      "automerge": false
    },
    {
      "description": "ArgoCD major needs manual review - minor/patch automerge",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["argo-cd"],
      "matchUpdateTypes": ["major"],
      "labels": ["manual-review/argocd"],
      "automerge": false
    },
    {
      "description": "Group non-critical Terraform providers",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "excludePackageNames": ["siderolabs/talos"],
      "groupName": "terraform providers",
      "groupSlug": "terraform-providers",
      "labels": ["terraform"]
    },
    {
      "description": "Automerge patch/minor for Helm charts (ArgoCD, Cilium, Gateway API) - safe for homelab",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["argo-cd", "cilium", "gateway-api-crds"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "labels": ["automerge/minor"]
    },
    {
      "description": "Automerge patch for Terraform providers - minor/major needs review",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "excludePackageNames": ["siderolabs/talos"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "labels": ["automerge/patch"]
    },
    {
      "description": "K8s patch automerge only - minor needs Talos support check (1.13 max 1.36)",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["kubernetes/kubernetes"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "labels": ["automerge/patch"]
    },
    {
      "description": "Major updates still need manual review",
      "matchUpdateTypes": ["major"],
      "labels": ["manual-review/major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/variables\\.tf$/", "/^variables\\.tf$/"],
      "matchStrings": [
        "variable\\s+\"talos_version\"[\\s\\S]*?default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/variables\\.tf$/", "/^variables\\.tf$/"],
      "matchStrings": [
        "variable\\s+\"argocd_version\"[\\s\\S]*?default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "argo-cd",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/variables\\.tf$/", "/^variables\\.tf$/"],
      "matchStrings": [
        "variable\\s+\"cilium_version\"[\\s\\S]*?default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "cilium",
      "registryUrlTemplate": "https://helm.cilium.io",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/variables\\.tf$/", "/^variables\\.tf$/"],
      "matchStrings": [
        "variable\\s+\"gateway_api_crds_version\"[\\s\\S]*?default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "gateway-api-crds",
      "registryUrlTemplate": "https://christianhuth.github.io/helm-charts",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/variables\\.tf$/", "/^variables\\.tf$/"],
      "matchStrings": [
        "variable\\s+\"kubernetes_version\"[\\s\\S]*?default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver"
    }
  ]
}
